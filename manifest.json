{
  "manifest_version": 3,
  "name": "SnapGrab — Instant Step-by-Step Guides",
  "version": "1.0.0",
  "description": "Record your clicks and turn them into a shareable step-by-step guide with annotated screenshots. Works in Chrome and Brave.",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SnapGrab — Record a guide"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
